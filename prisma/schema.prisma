// United Papers — pilot schema (DEMO). Extensible to purchasing, invoicing,
// customer pricing, deliveries and payments without breaking changes.
// DB-level CHECK constraints (stock can never go negative / over-reserved)
// are added by hand in the init migration — see docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  CONFIRMED
  PICKED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
}

enum MovementType {
  RECEIPT
  RESERVE
  RELEASE
  SHIP
  ADJUSTMENT
}

model Category {
  id          String    @id @default(uuid(7)) @db.Uuid
  slug        String    @unique
  name        String
  description String    @default("")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  products    Product[]

  @@map("categories")
}

model Supplier {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  contactName  String
  email        String
  leadTimeDays Int
  minOrderCases Int     @default(1)
  isDemo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  variants     ProductVariant[]

  @@map("suppliers")
}

model Product {
  id          String           @id @default(uuid(7)) @db.Uuid
  categoryId  String           @db.Uuid
  slug        String           @unique
  name        String
  brand       String           @default("United Papers")
  description String           @default("")
  imageKind   String           @default("generic")
  imageUrl    String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@index([categoryId])
  @@map("products")
}

// The sellable SKU. Sold by the case.
model ProductVariant {
  id            String   @id @default(uuid(7)) @db.Uuid
  productId     String   @db.Uuid
  supplierId    String?  @db.Uuid
  sku           String   @unique
  name          String
  packLabel     String
  unitsPerCase  Int
  casePrice     Decimal  @db.Decimal(12, 2)
  unitCost      Decimal  @db.Decimal(12, 4)
  specs         Json     @default("{}")
  reorderPoint  Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  product       Product              @relation(fields: [productId], references: [id])
  supplier      Supplier?            @relation(fields: [supplierId], references: [id])
  balance       InventoryBalance?
  movements     InventoryMovement[]
  reservations  InventoryReservation[]
  orderLines    SalesOrderLine[]

  @@index([productId])
  @@map("product_variants")
}

// One row per SKU (single warehouse for the pilot; add warehouseId later).
model InventoryBalance {
  variantId String   @id @db.Uuid
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@map("inventory_balances")
}

// Immutable ledger of every stock change.
model InventoryMovement {
  id        String       @id @default(uuid(7)) @db.Uuid
  variantId String       @db.Uuid
  type      MovementType
  quantity  Int
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

model InventoryReservation {
  id          String            @id @default(uuid(7)) @db.Uuid
  orderLineId String            @unique @db.Uuid
  variantId   String            @db.Uuid
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  orderLine   SalesOrderLine    @relation(fields: [orderLineId], references: [id])

  @@index([variantId, status])
  @@map("inventory_reservations")
}

model Customer {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyName String
  contactName String
  email       String       @unique
  phone       String
  addressLine String
  city        String
  state       String
  zip         String
  isDemo      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  orders      SalesOrder[]

  @@map("customers")
}

model SalesOrder {
  id             String      @id @default(uuid(7)) @db.Uuid
  orderNumber    String      @unique
  customerId     String      @db.Uuid
  status         OrderStatus @default(CONFIRMED)
  idempotencyKey String      @unique
  deliveryMethod String      @default("DELIVERY")
  notes          String?
  subtotal       Decimal     @db.Decimal(12, 2)
  deliveryFee    Decimal     @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  isDemo         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  customer       Customer    @relation(fields: [customerId], references: [id])
  lines          SalesOrderLine[]

  @@index([customerId])
  @@index([createdAt])
  @@map("sales_orders")
}

// Price/cost/name snapshots so history never changes when the catalog does.
model SalesOrderLine {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderId       String   @db.Uuid
  variantId     String   @db.Uuid
  sku           String
  productName   String
  packLabel     String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  unitCost      Decimal  @db.Decimal(12, 4)
  lineTotal     Decimal  @db.Decimal(12, 2)
  order         SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  reservation   InventoryReservation?

  @@index([orderId])
  @@index([variantId])
  @@map("sales_order_lines")
}
