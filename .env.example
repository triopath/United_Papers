# Copy via `npm run setup:env` (generates random secrets) — never commit .env
# Local PostgreSQL (embedded, started with `npm run db:start`) or hosted (Supabase/Neon).
# If the password contains special characters, URL-encode them (e.g. @ -> %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:54329/unitedpapers?schema=public"
# Random 48+ byte string used to sign admin session cookies
SESSION_SECRET="CHANGE_ME_RANDOM_LONG_STRING"
NEXT_PUBLIC_DEMO_BANNER="true"
# Admin users are rows in the admin_users table:  npm run admin:create -- <email> <password>
